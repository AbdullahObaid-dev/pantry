// Pantry — core data model (SRS §8.3, ERD §8.1).
//
// Every enum, model, field, and relation below is verbatim from the SRS —
// matches the ERD exactly, per this stage's brief. The datasource and
// generator blocks are the one deliberate deviation from the SRS's literal
// text: see CONTRACT.md §11 for the full explanation. Short version — Prisma
// ORM v7 (this project uses 7.9.1) removed `datasource.url` from
// schema.prisma entirely (hard error P1012, not a warning) and requires a
// mandatory driver adapter. The connection URL now lives in
// apps/api/prisma.config.ts instead. The SRS's given
// `datasource { url = env("DATABASE_URL") } / generator { provider =
// "prisma-client-js" }` is pre-v7 syntax and does not run today.
//
// Vector column, generated tsvector column, and the trigram index are
// intentionally NOT here — Prisma has no native syntax for any of the three
// (see SRS §8.2). They're added via raw SQL migration in Stage 00c.

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma/client"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

enum IngredientCategory {
  produce
  protein
  dairy
  grain
  spice_condiment
  pantry_staple
  other
}

enum DietTag {
  vegetarian
  vegan
  pescatarian
  glutenFree
  dairyFree
  nutFree
}

enum RecipeStatus {
  draft
  enriching
  published
  needsReview
  rejected
  archived
}

enum EnrichmentSource {
  seedImport
  userSubmission
  manualEdit
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  avatarUrl        String?
  googleId         String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pantryItems      PantryItem[]
  savedRecipes     SavedRecipe[]
  cookedLogs       CookedLog[]
  submittedRecipes Recipe[]      @relation("SubmittedBy")
  searchEvents     SearchEvent[]
}

model Ingredient {
  id            String             @id @default(cuid())
  canonicalName String             @unique
  category      IngredientCategory
  isAllergen    Boolean            @default(false)
  createdAt     DateTime           @default(now())

  aliases           IngredientAlias[]
  recipeIngredients RecipeIngredient[]
  pantryItems       PantryItem[]
  substitutesFrom   SubstitutionEdge[] @relation("SubFrom")
  substitutesTo     SubstitutionEdge[] @relation("SubTo")
}

model IngredientAlias {
  // pg_trgm GIN index on aliasText added via raw migration -- see 8.2.
  id           String           @id @default(cuid())
  ingredientId String
  ingredient   Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  aliasText    String           @unique
  source       EnrichmentSource @default(seedImport)
  createdAt    DateTime         @default(now())

  @@index([ingredientId])
}

model MoodTag {
  // Deliberately a reference table, not a Prisma enum: this vocabulary is expected to grow
  // as enrichment encounters new descriptive language, and a table row doesn't need a
  // migration the way adding an enum value would. DietTag (below) is the opposite call --
  // stable, small, and safety-relevant enough to want compile-time and DB-level enforcement.
  slug        String   @id
  displayName String
  createdAt   DateTime @default(now())

  recipes     RecipeMoodTag[]
}

model RecipeMoodTag {
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  moodTagSlug String
  moodTag     MoodTag  @relation(fields: [moodTagSlug], references: [slug], onDelete: Restrict)

  @@id([recipeId, moodTagSlug])
}

model Recipe {
  // embedding Unsupported("vector(1536)")?          -- added via raw migration, see 8.2 / Stage 00c
  // searchVector (generated tsvector, GIN-indexed)  -- added via raw migration, see 8.2 / Stage 00c
  id                    String       @id @default(cuid())
  title                 String
  description           String?
  instructions          Json         // ordered [{ id, text, timerSeconds? }]
  cuisine               String?
  prepTimeMinutes       Int?
  cookTimeMinutes       Int?
  baseServings          Int          @default(4)
  imageUrl              String?
  sourceUrl             String?
  sourceAttribution     String?      // required when not originally authored by the submitter
  status                RecipeStatus @default(draft)
  dietTags              DietTag[]
  dietTagsAutoGenerated Boolean      @default(true)   // false once a human has confirmed/edited
  submittedById         String?
  submittedBy           User?        @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  contentHash           String       // hash of title+ingredients+instructions; drives re-enrichment
  embeddingModelVersion String?
  // Added in Stage 00c: the SRS's given raw SQL for the search_vector generated column (below)
  // references these three column names, but nothing in the SRS ever declares them -- not in
  // this schema, not in any migration. Unlike embedding/searchVector, these are plain text with
  // no special Postgres type, so Prisma can express them natively -- no reason to exclude them.
  // Nullable, not defaulted to '': the raw SQL below already coalesce()s them, and they
  // legitimately start empty until the enrichment pipeline (SRS §10.1) populates them.
  moodTagsText          String?      @map("mood_tags_text")
  ingredientNamesText   String?      @map("ingredient_names_text")
  instructionsText      String?      @map("instructions_text")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  ingredients RecipeIngredient[]
  moodTags    RecipeMoodTag[]
  savedBy     SavedRecipe[]
  cookedLogs  CookedLog[]

  @@index([status])
}

model RecipeIngredient {
  id             String     @id @default(cuid())
  recipeId       String
  recipe         Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  rawText        String     // original freeform line, shown to the user as-is
  quantity       Float?
  unit           String?
  isOptional     Boolean    @default(false)
  scalesLinearly Boolean    @default(true)   // false for to-taste seasoning, leavening agents
  sortOrder      Int

  @@index([recipeId])
  @@index([ingredientId])
}

model PantryItem {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Float?
  unit         String?
  expiresAt    DateTime?
  addedAt      DateTime   @default(now())

  @@unique([userId, ingredientId])
  @@index([userId])
}

model SavedRecipe {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  note     String?
  savedAt  DateTime @default(now())

  @@unique([userId, recipeId])
}

model CookedLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rating   Int?     // 1-5
  note     String?
  cookedAt DateTime @default(now())

  @@index([userId])
  @@index([recipeId])
}

model SubstitutionEdge {
  id               String           @id @default(cuid())
  fromIngredientId String
  fromIngredient   Ingredient       @relation("SubFrom", fields: [fromIngredientId], references: [id], onDelete: Cascade)
  toIngredientId   String
  toIngredient     Ingredient       @relation("SubTo", fields: [toIngredientId], references: [id], onDelete: Cascade)
  context          String?          // e.g. "baking", "if out of"
  confidence       Float            @default(0.7)
  source           EnrichmentSource @default(seedImport)

  @@unique([fromIngredientId, toIngredientId, context])
}

model SearchEvent {
  id                     String   @id @default(cuid())
  userId                 String?
  user                   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rawQuery               String
  extractedIngredientIds String[]
  extractedFilters       Json?
  vibeAmount             Float    // slider position at search time, 0-1
  usedLlmExtraction      Boolean  @default(false)
  resultRecipeIds        String[]
  clickedRecipeId        String?
  createdAt              DateTime @default(now())

  @@index([createdAt])
}

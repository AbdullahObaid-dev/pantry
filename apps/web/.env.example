# See CONTRACT.md §3 for the full project-wide checklist and what provisions each var.
# Copy to .env.local and fill in real values — never commit the filled-in file.
# Wired up (NextAuth + JWT) in Stage 00d; unused by the code until then.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=SECRET
GOOGLE_CLIENT_ID=SECRET
GOOGLE_CLIENT_SECRET=SECRET

# Base URL of apps/api. Defaults assumed by this scaffold: web on :3000, api on :4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

{
  "name": "@pantry/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "DTOs shared between apps/web and apps/api. Empty until a stage defines an API contract (see CONTRACT.md §6/§7).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "postinstall": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}

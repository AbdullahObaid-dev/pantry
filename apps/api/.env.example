# See CONTRACT.md §3 for the full project-wide checklist and what provisions each var.
# Copy to .env and fill in real values — never commit the filled-in file.

# Local dev port for this Nest app (not in the CONTRACT §3 checklist — a scaffold
# convention, not a locked contract value; change freely).
PORT=4000

# Auth (Stage 00d) — same value as apps/web's NEXTAUTH_SECRET.
JWT_SHARED_SECRET=

# Database (Stage 00b/00c) — Neon/Supabase Postgres with pgvector + pg_trgm enabled.
DATABASE_URL=

# Embeddings (Stage 04a) — OpenAI text-embedding-3-small.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_MONTHLY_BUDGET_USD=

# Query-understanding escalation model (Stage 04c).
QUERY_LLM_API_KEY=

# Object storage (Stage 01c/06b or wherever image handling lands) — Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Job queue (ingestion pipeline, Stage 01c+) — Upstash Redis.
REDIS_URL=
